# ── Database (local Postgres + pgvector via docker-compose) ──────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=plabix
DB_PASSWORD=plabix_local_dev
DB_NAME=plabix_nexus
# Full connection string (used by the app; must match the values above).
# Use 127.0.0.1, not localhost: Docker Desktop on Windows can reset IPv6 (::1) connections.
DATABASE_URL=postgresql://plabix:plabix_local_dev@127.0.0.1:5432/plabix_nexus

# ── Auth ───────────────────────────────────────────────────────────────────
# Random 32+ char secret used to sign session tokens. Generate with:
#   openssl rand -base64 32     (or: npm run setup, which generates one)
# Must be 32+ characters; the app refuses to start in production otherwise.
SESSION_SECRET=replace-this-with-a-long-random-secret
SESSION_COOKIE_NAME=plabix_session
SESSION_MAX_AGE_SECONDS=604800
# Secure cookies default to on in production. Set false only for plain-HTTP LAN testing.
# SESSION_COOKIE_SECURE=true
# Trust X-Forwarded-For for rate limiting (only behind a reverse proxy you control).
# TRUST_PROXY=false

# ── AI Provider (default: Ollama — local, $0 cost) ───────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# Context window for chat (Ollama default is too small for RAG prompts).
OLLAMA_NUM_CTX=4096
# Keep models loaded between requests (avoids slow cold starts).
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CHAT_TIMEOUT_MS=180000
OLLAMA_EMBEDDING_TIMEOUT_MS=120000
# For reasoning models such as qwen3, set false to skip slow "thinking" output.
# OLLAMA_THINK=false

# ── RAG tuning ────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
# Calibrated for nomic-embed-text with task prefixes: relevant >= ~0.65, off-topic <= ~0.56.
RAG_SIMILARITY_THRESHOLD=0.6
RAG_MAX_CONTEXT_CHARS=8000

# ── Background ingestion ─────────────────────────────────────────────────
# Documents processed in parallel (keep 1 on a single machine running Ollama).
INGESTION_CONCURRENCY=1

# ── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./storage/documents
UPLOAD_ALLOWED_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Plabix Nexus
