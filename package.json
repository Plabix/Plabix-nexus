{
  "name": "plabix-nexus",
  "version": "0.2.0",
  "private": true,
  "description": "Plabix Nexus — your company's AI knowledge operating system. Local-first, $0 AI cost RAG platform.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "setup": "node --env-file-if-exists=.env.local scripts/setup.mjs"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
